import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp
m, c, k = 1.0, 0.8, 4.0
def system(t, X):
    x, v = X
    return [v, -(c/m)*v - (k/m)*x]
# Phase plane
x, v = np.linspace(-3, 3, 25), np.linspace(-4, 4, 25)
X, V = np.meshgrid(x, v)
plt.figure(figsize=(8, 6))
plt.streamplot(X, V, V, -(c/m)*V-(k/m)*X,
               color='gray', density=1.2)
# Trajectories from different initial conditions
ics = [[2, 0], [-2, 0], [0, 3], [0, -3],
       [2, 2], [-2, -2], [3, -2], [-3, 2]]
for x0 in ics:
    sol = solve_ivp(system, [0, 20], x0,
                    t_eval=np.linspace(0, 20, 1000))
    plt.plot(sol.y[0], sol.y[1])
    plt.scatter(*x0, s=25)

plt.scatter(0, 0, color='red', marker='*',
            s=150, label='Equilibrium')
plt.xlabel('Displacement (x)')
plt.ylabel('Velocity (dx/dt)')
plt.title('Phase Portrait of Linear Mass-Spring-Damper System')
plt.grid(alpha=0.3)
plt.legend()
plt.tight_layout()
plt.show()
